{
  "name": "kenn-forge-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "scripts": {
    "dev": "node ../node_modules/vite-plus/bin/vp dev",
    "build": "node ../node_modules/vite-plus/bin/vp build --logLevel warn",
    "preview": "node ../node_modules/vite-plus/bin/vp preview",
    "check": "cd .. && node node_modules/vite-plus/bin/vp run frontend-package-check",
    "lint": "node ../node_modules/vite-plus/bin/vp lint . --no-error-on-unmatched-pattern",
    "lint:fix": "node ../node_modules/vite-plus/bin/vp lint . --fix --no-error-on-unmatched-pattern",
    "typecheck": "cd .. && node node_modules/vite-plus/bin/vp run frontend-package-typecheck",
    "test": "node ../node_modules/vite-plus/bin/vp test run --project unit-node --project unit-jsdom",
    "test:browser": "node ../node_modules/vite-plus/bin/vp test run --project browser",
    "test:e2e": "node ./scripts/run-e2e-to-file.ts",
    "test:e2e:mock": "node ../node_modules/vite-plus/bin/vp exec -- playwright test --config=playwright.config.ts",
    "demo-workspace": "node node_modules/.bin/playwright test --config tests/demo/playwright-demo.config.ts",
    "effect:diagnostics": "NODE_PATH=../node_modules node node_modules/@effect/language-service/cli.js diagnostics --project tsconfig.json --format text --severity error",
    "profile:workspace-switch": "node node_modules/.bin/playwright test --config tests/profiling/playwright-profile.config.ts workspace-switch.spec.ts",
    "profile:slow-link": "node node_modules/.bin/playwright test --config tests/profiling/playwright-profile.config.ts slow-link.spec.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@effect/platform-browser": "4.1.1",
    "@kenn-io/kata-ui": "github:kenn-io/kata#v0.23.0",
    "@kenn-io/kit-ui": "github:kenn-io/kit-ui#9708f472d162c6019b3d96301720a582dc1c8234",
    "@lucide/svelte": "1.66.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@pierre/diffs": "1.6.2",
    "@pierre/trees": "1.0.0-beta.6",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-bubble-menu": "3.32.2",
    "@tiptap/extension-document": "3.32.2",
    "@tiptap/extension-floating-menu": "3.32.2",
    "@tiptap/extension-hard-break": "3.32.2",
    "@tiptap/extension-paragraph": "3.32.2",
    "@tiptap/extension-placeholder": "3.32.2",
    "@tiptap/extension-text": "3.32.2",
    "@tiptap/extensions": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/suggestion": "3.32.2",
    "@videojs/html": "10.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "0.10.0-beta.331",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.20.0-beta.329",
    "@xterm/xterm": "6.1.0-beta.336",
    "dompurify": "3.4.17",
    "effect": "4.1.1",
    "js-toml": "^2.0.0",
    "marked": "18.1.2",
    "mermaid": "12.2.0",
    "prosemirror-state": "^1.4.4",
    "shiki": "4.5.0",
    "simple-icons": "^16.19.0",
    "svelte-tiptap": "3.0.2"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@effect/vitest": "4.1.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "^26.0.0",
    "@vitest/browser-playwright": "5.0.5",
    "jsdom": "30.1.3",
    "orval": "8.46.0",
    "playwright": "1.64.1",
    "svelte": "5.57.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.5.0",
    "vitest": "5.0.5",
    "vitest-browser-svelte": "^3.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.22.1 <27",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.4.4"
}
