{
  "source": "./internal/server",
  "rules": [
    {"file": "^api_test\\.go$", "match": "Workspace|Worktree|Runtime|Tmux|Terminal|Pty|Session|Launch|Agent", "dest": "internal/server/runtimeservertest"},
    {"file": "^api_test\\.go$", "match": "Issue", "dest": "internal/server/issueservertest"},
    {"file": "^api_test\\.go$", "match": "Activity|Notification|Event|Feed|SSE|Stream", "dest": "internal/server/activityservertest"},
    {"file": "^api_test\\.go$", "match": "Merge|Approve|Review|Ready|Close|Reopen|Comment|Label|Assign", "dest": "internal/server/pullreviewservertest"},
    {"file": "^api_test\\.go$", "match": "PR|Pull|MR|Diff|Commit|File|Detail|Stack|CI|Check", "dest": "internal/server/pullservertest"},
    {"file": "^api_test\\.go$", "match": "", "dest": "internal/server/reposervertest"},
    {"file": "^(tmux_wrapper|host_runtime|workspace_runtime.*|projects_runtime.*|terminal.*|shutdown)_test\\.go$", "match": "", "dest": "internal/server/runtimeservertest"},
    {"file": "^(event_hub|federation_events|notifications)_test\\.go$", "match": "", "dest": "internal/server/activityservertest"},
    {"file": "^(api_auth|host_check|basepath|spa_handler|startup_handler)_test\\.go$", "match": "", "dest": "internal/server/accessservertest"},
    {"file": "", "match": "", "dest": "internal/server/settingsservertest"}
  ],
