{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if root=$(git rev-parse --show-toplevel 2>/dev/null); then bash \"$root/scripts/hooks/frontend-deps-session-start.sh\"; fi",
            "timeout": 300,
            "statusMessage": "Installing frontend dependencies"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/context-sync-stop.sh\" stop",
            "timeout": 30,
            "statusMessage": "Checking context-sync state"
          }
        ]
      }
    ]
  }
}
