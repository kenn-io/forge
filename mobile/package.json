{
  "name": "kenn-forge-mobile",
  "version": "0.1.0",
  "private": true,
  "license": "Elastic-2.0",
  "main": "index.ts",
  "scripts": {
    "start": "node node_modules/expo/bin/cli start",
    "android": "node scripts/build-web.mjs && node node_modules/expo/bin/cli run:android",
    "release:android": "node scripts/release-android.mjs",
    "ios": "node scripts/build-web.mjs && node node_modules/expo/bin/cli run:ios",
    "check": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --experimental-strip-types --test *.test.ts && node ../node_modules/vite-plus/bin/vp test run --config vitest.config.mts",
    "build:web": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "expo": "57.0.27",
    "expo-asset": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-file-system": "~57.0.5",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-webview": "13.17.0"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "jsdom": "30.1.2",
    "react-test-renderer": "19.3.0",
    "typescript": "6.0.3",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "packageManager": "bun@1.4.3",
  "patchedDependencies": {
    "react-native-webview@13.16.1": "patches/react-native-webview@13.16.1.patch"
  }
}
