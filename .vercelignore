# Vercel uploads only the static docs build inputs. Screenshot generation,
# application builds, test tooling, and local artifacts stay on the developer
# or CI machine.
/*
!/docs
/docs/*
!/docs/archive.md
!/docs/commands.md
!/docs/configuration.md
!/docs/federated-fleet.md
!/docs/index.md
!/docs/integrations.md
!/docs/kenn-forge-mcp.md
!/docs/llms.txt
!/docs/overrides
/docs/overrides/*
!/docs/overrides/main.html
!/docs/quickstart.md
!/docs/settings.md
!/docs/stylesheets
/docs/stylesheets/*
!/docs/stylesheets/extra.css
!/docs/troubleshooting.md
!/docs/workflows.md
!/docs/workflows
/docs/workflows/*
!/docs/workflows/activity.md
!/docs/workflows/code-reviewer.md
!/docs/workflows/docs.md
!/docs/workflows/issue-triager.md
!/docs/workflows/repositories.md
!/docs/workflows/workspaces.md
!/docs/zensical.toml
!/frontend
/frontend/*
!/frontend/public
/frontend/public/*
!/frontend/public/favicon.svg
!/scripts
/scripts/*
!/scripts/build-docs.mjs
!/scripts/docs-assets.ref
!/scripts/docs-assets.txt
!/scripts/sync-docs-assets.sh
!/scripts/vercel-build-docs.sh
!/scripts/vercel-install-docs.sh
!/website
!/vercel.json
