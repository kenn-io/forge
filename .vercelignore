# Vercel CLI builds its upload tree from this file, not .gitignore.
# Keep the source required by the remote docs build and omit local artifacts.
.env*
/.repos/
/.roborev/
/.sessions
/.superpowers/
/.superset/
/.vercel/
/.worktrees/
/.claude/worktrees/

node_modules/
**/node_modules/

/tmp/
/target/
/site/
/docs/assets/generated/
/frontend/dist/
/frontend/playwright-report/
/frontend/test-results/
/frontend/.vitest-attachments/
/frontend/src/**/__screenshots__/
/packages/*/dist/
/internal/web/dist/
/internal/githubapp/ui/dist/

/kenn-forge
/kenn-forge.exe
/kenn-forge-github-app
/kenn-forge-github-app.exe
/e2e-server
/e2e-server.exe
/cmd/e2e-server/e2e-server
/cmd/e2e-server/e2e-server.exe

*.db
*.py[cod]
__pycache__/
